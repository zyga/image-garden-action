#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Canonical Ltd.
#
# pkgproxy-log - pick out what matters in the log of pkgproxy
#
# Reads the log of pkgproxy, as journalctl or snap logs print it, on
# standard input.
#
# Usage:
#   pkgproxy-log important
#       Print only the lines that tell what went wrong, coloured: warnings
#       and errors, such as "upstream answered with an error", which says
#       who answered; requests answered with an error status other than
#       404 and 410; the service failing, such as hitting systemd's start
#       limit; and Go panics. Of each kind of line, the same message with
#       the same status, only the first few are printed, and then how many
#       more there were, so that a warning repeated for every apt package
#       does not hide the one error. Prints nothing when there is none.
#   pkgproxy-log condensed
#       Print the whole log, but for the setup guidance that pkgproxy
#       prints each time it starts, which is replaced by one line.
set -eu

usage() {
	echo "Usage: pkgproxy-log important|condensed" >&2
	exit 64 # EX_USAGE
}

[ $# -eq 1 ] || usage

case "$1" in
important | condensed) ;;
*) usage ;;
esac

exec awk -v mode="$1" -v most="${PKGPROXY_LOG_MOST:-3}" '
BEGIN {
	esc = sprintf("%c", 27)
	reset = esc "[0m"; red = esc "[1;31m"; yellow = esc "[1;33m"
	guidance = 0
}

function out(s) { print s; fflush() }

# The guidance, from "pkgproxy is listening on" to the next line that
# slog wrote, which has a level.
mode == "condensed" {
	if (guidance) {
		if ($0 !~ / level=/) { skipped++; next }
		out("  … " skipped " lines of setup guidance left out")
		guidance = 0
	}
	out($0)
	if ($0 ~ /pkgproxy is listening on /) { guidance = 1; skipped = 0 }
	next
}

# kind is what lines of the same kind share: the message and the status of
# a line of slog, or what a line of systemd says, without the time and pid.
function kind(line,   k, m) {
	if (match(line, / msg=("[^"]*"|[^ ]*)/)) {
		k = substr(line, RSTART + 1, RLENGTH - 1)
		if (match(line, / status=[0-9]+/)) k = k substr(line, RSTART, RLENGTH)
		return k
	}
	if (match(line, /\]: /)) return substr(line, RSTART + 3)
	return line
}

# important prints line in color, unless most lines of its kind were printed
# already, and counts it.
function important(line, color,   k) {
	k = kind(line)
	if (!(k in seen)) order[++kinds] = k
	if (++seen[k] <= most) out(color line reset)
}

/ level=ERROR / || /panic: |fatal error: / { important($0, red); next }
/ level=WARN / { important($0, yellow); next }
/ msg="handled request" / && / status=(4[0-9][0-9]|5[0-9][0-9]) / && !/ status=(404|410) / { important($0, yellow); next }
/ systemd\[[0-9]+\]: / && /[Ff]ailed|start-limit|repeated too quickly|code=(exited|killed|dumped)|core-dump/ { important($0, red); next }

END {
	if (mode == "condensed" && guidance) out("  … " skipped " lines of setup guidance left out")
	for (i = 1; i <= kinds; i++)
		if (seen[order[i]] > most)
			out("  … " (seen[order[i]] - most) " more " (seen[order[i]] - most == 1 ? "line" : "lines") " of " order[i])
}
'
